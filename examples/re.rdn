"Regex" load
"Io" load

[*"*.c" "main.c" Regex::match-str call @println *]
[*"*.c" "hey i have my main.c file" Regex::match-str call @println *]

"The order numbers are 4582, 9102, and 3341."
"*,"
Regex::search call
Io::@println

"The order numbers are 4582, 9102, and 3341."
"*,"
Regex::search-all call
Io::@println
