"Typecheck" load
"Core" load

Typecheck open
Typecheck::OGTypes open
Core open

"../nativelibs/sqlite3" __sharedlib_ext @str append loadnative

[*
* Sqlite module: SQLite databases through native cursors.
*
*   "./data.db" Sqlite::connect call db let
*   db "CREATE TABLE t (a)" Sqlite::exec call
*   db "INSERT INTO t VALUES (?)" Sqlite::cursor call cur let
*   cur (42) Sqlite::bind call
*   cur Sqlite::step call          -> null when done
*   cur Sqlite::close-cursor call
*   db Sqlite::close call
* *]
Sqlite module

    SqliteTyping module
        List DB const
        List Cursor const
    end

    [*
    * open a database file (created when missing)
    *   "./data.db" Sqlite::connect call -> conn
    * *]
    connect (Str) (Sqlite::SqliteTyping::DB) defun
        __m__sqlite3__open call
    end

    [*
    * run SQL that returns no rows (DDL / DML)
    *   db "CREATE TABLE t (a)" Sqlite::exec call
    * *]
    exec (Sqlite::SqliteTyping::DB Str) () defun
        __m__sqlite3__exec call
    end

    [*
    * prepare a statement for repeated bind/step
    *   db "SELECT ..." Sqlite::cursor call -> cursor
    * *]
    cursor (Sqlite::SqliteTyping::DB Str) (Sqlite::SqliteTyping::Cursor) defun
        __m__sqlite3__cursor call
    end

    [*
    * bind a list of parameters (Int Real Bool Str Null) in order;
    * rebinding resets the cursor so it can be stepped again
    *   cur (1 "x") Sqlite::bind call
    * *]
    bind (Sqlite::SqliteTyping::Cursor List) () defun
        __m__sqlite3__bind call
    end

    [*
    * step the cursor: pushes the next row as a list of values, or null
    * when no rows remain; a spent cursor keeps answering null
    *   cur Sqlite::step call -> ("Alice" 30)
    * left unsigned because it may return either a list or null
    * *]
    step (Sqlite::SqliteTyping::Cursor) (List) defun
        __m__sqlite3__step call
    end

    [*
    * finalize a cursor
    *   cur Sqlite::close-cursor call
    * *]
    close-cursor (Sqlite::SqliteTyping::Cursor) () defun
        __m__sqlite3__close_cursor call
    end

    [*
    * close a connection (open cursors keep it alive until closed)
    *   db Sqlite::close call
    * *]
    close (Sqlite::SqliteTyping::DB) () defun
        __m__sqlite3__close call
    end

    @connect apply
        Sqlite::connect call
    end

    @exec apply
        Sqlite::exec call
    end

    @cursor apply
        Sqlite::cursor call
    end

    @bind apply
        Sqlite::bind call
    end

    @step apply
        Sqlite::step call
    end

    @close-cursor apply
        Sqlite::close-cursor call
    end

    @close apply
        Sqlite::close call
    end

end
