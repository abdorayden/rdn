[* 
math.rdn
Copyright (c) 2023-2026 Ray Den
SPDX-License-Identifier: MIT

Purpose:
Pure Raden math helpers that do not require native modules.

Exports:
- pow : integer-friendly exponentiation implemented in Raden itself

Stack contract:
base exponent pow call -> result

Notes:
- positive exponents multiply repeatedly
- zero exponent returns 1
- negative exponents return the reciprocal

Examples:
"./libs/math.rdn" load
2 6 pow call print
"\n" print
2 -3 pow call print
"\n" print
-2 3 pow call print
*]

pow defun
    power_number let
    tha_number let
    1 result let

    power_number 0 > if
        0 i let
        i power_number < condition let

        condition loop
            result tha_number * result set

            i 1 + i let
            i power_number < condition set
            condition
        end
    else
        power_number 0 < if
            power_number -1 * positive_power let

            0 i let
            i positive_power < condition let

            condition loop
                result tha_number * result set

                i 1 + i let
                i positive_power < condition set
                condition
            end

            1 result / result set
        else
            power_number 0 = if
                1 result set
            end
        end
    end

    result
end
