"Core" load
"../nativelibs/files" __sharedlib_ext @str append loadnative
"Typecheck" load

[*
*   Files module 
*   it's a module that covered functionalities to write read and append text to a files
*   it has nested module named File allowing to open file discriptor to work with it
* *]

Files module
    File module

        [*
        *   fileptr are passed in params if it's null it will use the local file-ptr of the module
        *   in case you don't need to open multiple files
        * *]

        null fd-ptr let
        nativestdin  call stdin  const
        nativestdout call stdout const
        nativestderr call stderr const

        fopen ( Str [* filename *] Str [* mode *]) (Any) defun
            openFileHandle call Files::File::fd-ptr set
            Files::File::fd-ptr
        end

        fread (Any [*fileptr*] Int [* byte count *]) (Str) defun

            swap
            [*int ptr*]
            dup
            [*int ptr*]
            null = [*int ptr bool*] if
                
                Files::File::fd-ptr null = if
                    "non of file descriptor or given fileptr are opened" error
                else
                    pop
                    Files::File::fd-ptr swap readFromFileHandle call
                end
            else
                swap readFromFileHandle call
            end

        end

        fwrite (Any Str) (Bool) defun

            swap
            [*str ptr*]
            dup
            [*str ptr*]
            null = [*str ptr bool*] if
                Files::File::fd-ptr null = if
                    "non file descriptor and given fileptr param are opened" error
                else
                    pop
                    Files::File::fd-ptr swap writeFromFileHandle call
                end
            else
                swap writeFromFileHandle call
            end
        end

        fclose (Any) (Bool) defun
            true ok let
            dup null != if
                closeHandle call ok set
            end
            Files::File::fd-ptr null != if
                Files::File::fd-ptr 
                closeHandle call ok set
                null Files::File::fd-ptr set
            end

            ok
        end
    end

    read-lines (Str [* file path *]) (List [* list of lines *]) defun
        readLines call
    end

    read-text (Str [* file path *]) (Str [* file content *]) defun
        readText call
    end

    write-lines (Str [* file path *] List [* list of lines *]) (Bool [* if it's okay or not *]) defun
        writeLines call
    end

    write-text (Str [* file path *] Str [* string content *]) (Bool [* if it's okay or not *]) defun
        writeText call
    end

    append-lines (Str [* file path *] List [* list of lines *]) (Bool [* if it's okay or not *]) defun
        appendLines call
    end

    append-text (Str [* file path *] Str [* string content *]) (Bool [* if it's okay or not *]) defun
        appendText call
    end

    @read-lines apply Files::read-lines call end
    @write-lines apply Files::write-lines call end
    @append-lines apply Files::append-lines call end
    @read-text apply Files::read-text call end
    @write-text apply Files::write-text call end
    @append-text apply Files::append-text call end

    [*safe*]
    @safe-read-lines apply Files::read-lines scall end
    @safe-write-lines apply Files::write-lines scall end
    @safe-append-lines apply Files::append-lines scall end
    @safe-read-text apply Files::read-text scall end
    @safe-write-text apply Files::write-text scall end
    @safe-append-text apply Files::append-text scall end

end
