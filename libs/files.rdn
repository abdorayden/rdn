"Typecheck" load
"Core" load

Typecheck open
Typecheck::OGTypes open
Core open

"../nativelibs/files" __sharedlib_ext @str append loadnative


[*
*   Files module 
*   it's a module that covered functionalities to write read and append text to a files
*   it has nested module named File allowing to open file discriptor to work with it
* *]

Files module
    File module

        [*
         *  FileTyping is an internal module of File module that holds types of fopen,fwrite,... functions of File module
         *  it's accesable for other modules but it used for clear and clean signature as documented functions
         * *]
        FileTyping module
            [*
             *  NullAbleFILEPTR is an alias constants for Any because it can be null 
             *  also it can be a ptr of FILE stream
             * *]
            Any NullAbleFILEPTR const

            Int SeekMode const
            Int Byte const
        end

        [*
        *   fileptr are passed in params if it's null it will use the local file-ptr of the module
        *   in case you don't need to open multiple files
        * *]

        null fd-ptr let

        [*
        *   standard system fils stream 
        *   stdin
        *   stdout
        *   stderr
        * *]
        nativestdin  call stdin  const
        nativestdout call stdout const
        nativestderr call stderr const
        -1 EOF const

        Seek module
            0	SET	const [* Seek from beginning of file.  *]
            1	CUR	const [* Seek from current position.  *]
            2	END	const [* Seek from end of file.  *]
        end

        fopen ( Str [* filename *] Str [* mode *]) (Files::File::FileTyping::NullAbleFILEPTR) defun
            openFileHandle call Files::File::fd-ptr set
            Files::File::fd-ptr
        end

        fread (Files::File::FileTyping::NullAbleFILEPTR [*fileptr*] Int [* byte count *]) (Str) defun

            swap
            [*int ptr*]
            dup
            [*int ptr*]
            null = [*int ptr bool*] if
                
                Files::File::fd-ptr null = if
                    "non of file descriptor or given fileptr are available both of them are null" error
                else
                    pop
                    Files::File::fd-ptr swap readFromFileHandle call
                end
            else
                swap readFromFileHandle call
            end

        end

        fwrite (Files::File::FileTyping::NullAbleFILEPTR Str) (Bool) defun

            swap
            [*str ptr*]
            dup
            [*str ptr*]
            null = [*str ptr bool*] if
                Files::File::fd-ptr null = if
                    "non file descriptor and given fileptr param are available both of them are null" error
                else
                    pop
                    Files::File::fd-ptr swap writeFromFileHandle call
                end
            else
                swap writeFromFileHandle call
            end
        end

        fclose (Files::File::FileTyping::NullAbleFILEPTR) (Bool) defun
            true ok let
            dup null != if
                closeHandle call ok set
            end
            Files::File::fd-ptr null != if
                Files::File::fd-ptr 
                closeHandle call ok set
                null Files::File::fd-ptr set
            end

            ok
        end

        fseek (
            Files::File::FileTyping::NullAbleFILEPTR 
            Int [*as position*]
            Files::File::FileTyping::SeekMode [* Files::File::Seek::SET*]
            ) () defun

            mode let
            pos let
            stream let

            stream null = if 
                Files::File::fd-ptr null != if
                    Files::File::fd-ptr
                    mode
                    pos
                    seek_file call
                else
                    "non file descriptor and given fileptr param are available both of them are null" error
                end
            else
                stream
                pos
                mode
                seek_file call
            end

        end

        fis-error (Files::File::FileTyping::NullAbleFILEPTR) (Bool) defun

            dup null = if
                pop [*get rid of it*]
                Files::File::fd-ptr null != if
                    Files::File::fd-ptr
                    file_error call
                else
                    "non file descriptor and given fileptr param are available both of them are null" error
                end
            else
                file_error call
            end

        end

        [*returns byte of the current pointer of the stream*]
        fget-byte (Files::File::FileTyping::NullAbleFILEPTR) (Files::File::FileTyping::Byte) defun 

            dup null = if
                pop [*get rid of it*]
                Files::File::fd-ptr null != if
                    Files::File::fd-ptr
                    get_byte call
                else
                    "non file descriptor and given fileptr param are available both of them are null" error
                end
            else
                get_byte call
            end
        end

        feof (Files::File::FileTyping::NullAbleFILEPTR) (Bool) defun

            __check_eof demac
                Files::File::fget-byte call Files::File::EOF =
            end

            dup null = if
                pop [*get rid of it*]
                Files::File::fd-ptr null != if
                    Files::File::fd-ptr
                    __check_eof
                else
                    "non file descriptor and given fileptr param are available both of them are null" error
                end
            else
                __check_eof
            end
        end

    end

    read-lines (Str [* file path *]) (List [* list of lines *]) defun
        readLines call
    end

    read-text (Str [* file path *]) (Str [* file content *]) defun
        readText call
    end

    write-lines (Str [* file path *] List [* list of lines *]) (Bool [* if it's okay or not *]) defun
        writeLines call
    end

    write-text (Str [* file path *] Str [* string content *]) (Bool [* if it's okay or not *]) defun
        writeText call
    end

    append-lines (Str [* file path *] List [* list of lines *]) (Bool [* if it's okay or not *]) defun
        appendLines call
    end

    append-text (Str [* file path *] Str [* string content *]) (Bool [* if it's okay or not *]) defun
        appendText call
    end

    @read-lines apply Files::read-lines call end
    @write-lines apply Files::write-lines call end
    @append-lines apply Files::append-lines call end
    @read-text apply Files::read-text call end
    @write-text apply Files::write-text call end
    @append-text apply Files::append-text call end

    [*safe*]
    @safe-read-lines apply Files::read-lines scall end
    @safe-write-lines apply Files::write-lines scall end
    @safe-append-lines apply Files::append-lines scall end
    @safe-read-text apply Files::read-text scall end
    @safe-write-text apply Files::write-text scall end
    @safe-append-text apply Files::append-text scall end

end
