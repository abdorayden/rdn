[* 
strings.rdn
Copyright (c) 2023-2026 Ray Den
SPDX-License-Identifier: MIT

Purpose:
String-oriented helpers built in Raden itself, plus native helpers inspired by
Go's `strings` package.

Exports:
- concatBy : concatenate two values with a separator
- concat   : concatenate two values directly
- contains : text part -> boolean
- hasPrefix : text prefix -> boolean
- hasSuffix : text suffix -> boolean
- trimSpace : text -> string
- split     : text separator -> list of strings
- replaceAll : text old new -> string

Examples:
"\n" print
"foo" "bar" concat call print
"\n" print
"\n" print
"foo" "bar" "-" concatBy call print
"\n" print
"n=" 42 concat call print
*]

"Core" load
"Typecheck" load
"../nativelibs/strings" __sharedlib_ext str append loadnative

Strings module

    concat-by (Str Str Str) (Str) defun
        by let
        second let
        first let
        first str
        by str
        append
        second str
        append
    end

    concat (Str Str) (Str) defun
        second let
        first let
        first str
        second str
        append
    end

    contains (Str Str) (Bool) defun
        strContains call
    end

    has-prefix (Str Str) (Bool) defun
        strHasPrefix call
    end

    has-suffix (Str Str) (Bool) defun
        strHasSuffix call
    end

    trim-space (Str) (Str) defun
        strTrimSpace call
    end

    split (Str Str) (List) defun
        strSplit call
    end

    replace-all (Str Str Str) (Str) defun
        strReplaceAll call
    end

    @replace-all apply
        Strings::replace-all call
    end

    @has-prefix apply
        Strings::has-prefix call
    end

    @contains apply
        Strings::contains call
    end

    @concat-by apply
        Strings::concat-by call
    end

    @concat apply
        Strings::concat call
    end

    @trim-space apply
        Strings::trim-space call
    end

    @split apply
        Strings::split call
    end

end
