[* 
strings.rdn
Copyright (c) 2023-2026 Ray Den
SPDX-License-Identifier: MIT

Purpose:
String-oriented helpers built in Raden itself, plus native helpers inspired by
Go's `strings` package.

Exports:
- concatBy : concatenate two values with a separator
- concat   : concatenate two values directly
- contains : text part -> boolean
- hasPrefix : text prefix -> boolean
- hasSuffix : text suffix -> boolean
- trimSpace : text -> string
- split     : text separator -> list of strings
- replaceAll : text old new -> string

Examples:
"\n" print
"foo" "bar" concat call print
"\n" print
"\n" print
"foo" "bar" "-" concatBy call print
"\n" print
"n=" 42 concat call print
*]

"../nativelibs/strings" __sharedlib_ext to_string swap pop append loadnative

stringValue defun
    to_string
    swap pop
end

concatBy defun
    by let
    second let
    first let

    first stringValue call
    by stringValue call
    append
    second stringValue call
    append
end

concat defun
    second let
    first let

    first stringValue call
    second stringValue call
    append
end

contains defun
    strContains call
end

hasPrefix defun
    strHasPrefix call
end

hasSuffix defun
    strHasSuffix call
end

trimSpace defun
    strTrimSpace call
end

split defun
    strSplit call
end

replaceAll defun
    strReplaceAll call
end
