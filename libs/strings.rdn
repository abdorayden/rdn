[* 
strings.rdn
Copyright (c) 2023-2026 Ray Den
SPDX-License-Identifier: MIT

Purpose:
String-oriented helpers built in Raden itself.

Exports:
- concatBy : concatenate two values with a separator
- concat   : concatenate two values directly

Examples:
"\n" print
"foo" "bar" concat call print
"\n" print
"\n" print
"foo" "bar" "-" concatBy call print
"\n" print
"n=" 42 concat call print
*]

stringValue defun
    to_string
    swap pop
end

concatBy defun
    by let
    second let
    first let

    first stringValue call
    by stringValue call
    append
    second stringValue call
    append
end

concat defun
    second let
    first let

    first stringValue call
    second stringValue call
    append
end
