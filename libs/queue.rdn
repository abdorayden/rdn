"Typecheck" load
"Lists" load

Typecheck open
Typecheck::OGTypes open
Lists::@shift open
Lists::@isEmpty open

Queue module
    QueueTypes module
        List TQueue const
    end

    new () (Queue::QueueTypes::TQueue) defun
        ()
    end

    push (Queue::QueueTypes::TQueue Any) () defun
        append
    end

    peek (Queue::QueueTypes::TQueue) (Any) defun
        0 index
    end

    poop (Queue::QueueTypes::TQueue) (Any) defun
        [*
        *   i know i know just pop name is reserved that's why i can't name it pop
        * *]
        @shift
    end

    is-empty? (Queue::QueueTypes::TQueue) (Bool) defun
        @isEmpty
    end
end
