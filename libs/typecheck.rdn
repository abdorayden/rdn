[*
*   TODO: add sig for let keyword
* *]

"Core" load
Core::@str open

Typecheck module
     
     OGTypes module

        reset
        enum Int const
        enum Str const
        enum Bool const
        enum Real const
        enum List const
        enum Null const

        enum Func const
        enum Any const
        reset

     end

    [*
    *   state will contains list of lists 
    *   those lists has this structure
    *   (
    *       func_name
    *       (int int) params
    *       (real null) returns
    *   )
    * *]
    () State const

    [*
    *   Signed functions use normal defun with optional params and returns:
    *       add_ints (Int Int) (Int) defun
    *           +
    *       end
    * *]

    [*
    *   scall will call the function and check the return values if it's match the sig
    * *]
    scall apply
        func let
        func __func_name fname let

        fname @str Typecheck::__tc_find_sig call sig let
        sig type "null" = if
            "typecheck: missing function signature" error
        end

        sig 1 index params let
        sig 2 index returns let

        params Typecheck::__tc_check_stack_types call ! if
            "typecheck: function arguments do not match signature" error
        end

        __stack_size params len - base-size let
        func pcall if
            __stack_size base-size - returns-found let
            returns-found returns len != if
                "typecheck: function returned wrong value count" error
            end

            returns Typecheck::__tc_check_stack_types call ! if
                "typecheck: function returns do not match signature" error
            end
        else
            error
        end
    end

    [*
    *   check will check the function sig before calling it
    * *]
    check apply
        func let
        func __func_name fname let

        fname to_string swap pop Typecheck::__tc_find_sig call sig let
        sig type "null" = if
            false
        else
            sig 1 index Typecheck::__tc_check_stack_types call
        end
    end

    __tc_type_code defun
        type t let

        t "integer" = if
            Typecheck::OGTypes::Int
        else
            t "string" = if
                Typecheck::OGTypes::Str
            else
                t "boolean" = if
                    Typecheck::OGTypes::Bool
                else
                    t "double" = if
                        Typecheck::OGTypes::Real
                    else
                        t "list" = if
                            Typecheck::OGTypes::List
                        else
                            t "null" = if
                                Typecheck::OGTypes::Null
                            else
                                t "function" = if
                                    Typecheck::OGTypes::Func
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    __tc_valid_type_code defun
        code let

        code Typecheck::OGTypes::Int = code Typecheck::OGTypes::Str = | code Typecheck::OGTypes::Bool = | code Typecheck::OGTypes::Real = | code Typecheck::OGTypes::List = | code Typecheck::OGTypes::Null = | code Typecheck::OGTypes::Func = | code Typecheck::OGTypes::Any = |
    end

    __tc_validate_types defun
        types let

        types type "list" != if
            "typecheck: signature types must be a list" error
        end

        true valid let
        0 i let
        i types len < valid & loop
            types i index Typecheck::__tc_valid_type_code call ! if
                false valid set
            end

            i 1 + i set
            i types len < valid &
        end

        valid ! if
            "typecheck: signature contains an unknown type" error
        end
    end

    __tc_find_sig defun
        fname let

        -1 found-index let
        Typecheck::State len 1 - i let
        i 0 >= found-index -1 = & loop
            Typecheck::State i index sig let
            sig 0 index fname = if
                i found-index set
            end

            i 1 - i set
            i 0 >= found-index -1 = &
        end

        found-index -1 = if
            null
        else
            Typecheck::State found-index index
        end
    end

    __tc_check_stack_types defun
        expected-types let
        expected-types len needed let

        __stack_size needed < if
            false
        else
            () popped let
            true ok let
            needed 1 - i let

            i 0 >= ok & loop
                expected-types i index expected let
                top-value let

                top-value Typecheck::__tc_type_code call actual let
                actual Func = if
                    popped top-value append
                else
                    top-value dup
                    popped swap append
                    pop
                end

                expected Any != actual expected != & if
                    false ok set
                end

                i 1 - i set
                i 0 >= ok &
            end

            popped len 1 - j let
            j 0 >= loop
                popped j index

                j 1 - j set
                j 0 >=
            end

            ok
        end
    end

end
