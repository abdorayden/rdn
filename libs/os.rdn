Purpose:
Cross-platform process and runtime helpers over the native syscall module.

*]

"../nativelibs/syscall" __sharedlib_ext to_string swap pop append loadnative
"Typecheck" load

Os module

    reset
    enum LINUX const
    enum WINDOWS const
    enum MACOS const
    reset

    platform () (Str) defun
        __sharedlib_ext str ext let
        ext ".dll" eq if 
            WINDOWS
        else ext ".dylib" eq if
            MACOS
        else ext ".so" eq if
            LINUX
        end end end
    end

    system (Str) (Int) defun
        systm call
    end

    get-pid () (Int) defun
        pid call
    end

    getenv (Str) (Str) defun
        getEnv call
    end

    sleep (Int) (Bool) defun
        sleepMs call
    end

    now () (Int) defun
        epochTime call
    end

    get-cwd () (Str) defun
        gtcwd call
    end

    cd (Str) (Int) defun
        chdr call
    end

    @platform apply Os::platform call end
    @system apply Os::system call end
    @get-pid apply Os::get-pid call end
    @get-cwd apply Os::get-cwd call end
    @getenv apply Os::getenv call end
    @sleep apply Os::sleep call end
    @now apply Os::now call end
    @cd apply Os::cd call end
end
