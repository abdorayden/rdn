Purpose:
Cross-platform network-adjacent helpers over the native net module.

Loading behavior:
This module chooses the shared-library suffix from __sharedlib_ext and loads:
../nativelibs/net(.so|.dylib|.dll)

Exports:
- host      : -> local host name
- encodeUrl : text -> percent-encoded text
- decodeUrl : text -> decoded text
*]

"Core" load
Core open
"Typecheck" load

Typecheck open
Typecheck::OGTypes open

"../nativelibs/net" __sharedlib_ext @str append loadnative

Net module

    Socket module

        SocketTypeProto module
            Str ProtocoleType const
            Int SockFD const
        end

        "tcp"  TCP_PROT  const
        "udp"  UDP_PROT  const
        "icmp" ICMP_PROT const
        "raw"  RAW_PROT  const

        new (Net::Socket::SocketTypeProto::ProtocoleType [* example: Net::Socket::TCP_PROT*]) (Net::Socket::SocketTypeProto::SockFD) defun
            socket_new call
        end

        connect (Int Str Int) (Bool) defun
            socket_connect call
        end

        bind (Int Str Int) (Bool) defun
            socket_bind call
        end

        listen (Int Int) (Bool) defun
            socket_listen call
        end

        accept (Int) (Int Str Int) defun
            socket_accept call
        end

        send (Int Str) (Int) defun
            socket_send call
        end

        recv (Int Int) (Str) defun
            socket_recv call
        end

        sendto (Int Str Str Int) (Int) defun
            socket_sendto call
        end

        recvfrom (Int Int) (Str Str Int) defun
            socket_recvfrom call
        end

        close (Int) (Bool) defun
            socket_close call
        end

        setnonblock (Int Bool) (Bool) defun
            socket_setnonblock call
        end

        setnodelay (Int Bool) (Bool) defun
            socket_setnodelay call
        end

        setbroadcast (Int Bool) (Bool) defun
            socket_setbroadcast call
        end

        getprotocol (Int) (Str) defun
            socket_getprotocol call
        end

    end

    Http module
    end

    host () (Str) defun
        hostName call
    end

    encode-url (Str) (Str) defun
        urlEncode call
    end

    decode-url (Str) (Str) defun
        urlDecode call
    end

    @decode-url apply
        Net::decode-url call
    end

    @encode-url apply
        Net::encode-url call
    end

    @host apply
        Net::host call
    end

end
