Purpose:
List-oriented helpers built in Raden itself.

Exports:
- each / foreach : list callback -> run callback for every item
- map            : list callback -> alias of each for side-effect iteration
- collect        : list callback -> new list of callback results
- filter         : list callback -> new list of items whose callback result is true
- reduce         : list initial callback -> accumulated value
- copy           : list -> cloned list
- reverse        : list -> reversed cloned list
- concat         : left right -> new list containing both lists
- first / head   : list -> first item or null
- last           : list -> last item or null
- tail / rest    : list -> new list without the first item
- count          : list -> integer length
- isEmpty        : list -> boolean
- includes       : list value -> boolean
- any            : list callback -> boolean
- all            : list callback -> boolean
- shift          : list-var -> first item removed from the list, or null
- popLast        : list-var -> last item removed from the list, or null
- unpack         : list -> ..values, or null
- insert         : list index value -> list

Examples:
"Lists" load

(1 2 3) doubler collect call print
"\n" print
(1 2 3 4) aboveTwo filter call print
"\n" print
(1 2 3 4) 0 add2 reduce call print
"\n" print
(1 2 3) reverse call print
"\n" print

doubler defun
  2 *
end

aboveTwo defun
  2 >
end

add2 defun
  +
end
*]

"Typecheck" load

Lists module

    each (List Func) () defun
        callback let
        tha-list let
        0 i let
        tha-list len list-length let
        i list-length < loop
            tha-list i index callback call
            i 1 + i set
            i list-length <
        end
    end

    Lists::each map let
    Lists::each foreach let

    copy (List) (List) defun
        tha-list let
        0 i let
        tha-list len list-length let
        (
            i list-length < loop
                tha-list i index
                i 1 + i set
                i list-length <
            end
        )
    end

    collect (List Func) (List) defun
        callback let
        tha-list let
        0 i let
        tha-list len list-length let
        (
            i list-length < loop
                tha-list i index callback call
                i 1 + i set
                i list-length <
            end
        )
    end

    filter (List Func) (List) defun
        callback let
        tha-list let
        0 i let
        tha-list len list-length let
        (
            i list-length < loop
                tha-list i index
                dup callback call if
                else
                    pop
                end
                i 1 + i set
                i list-length <
            end
        )
    end

    reduce (List Int Func) (Int) defun
        callback let
        accumulator let
        tha-list let
        0 i let
        tha-list len list-length let
        i list-length < loop
            accumulator tha-list i index callback call
            accumulator set
            i 1 + i set
            i list-length <
        end
        accumulator
    end

    reverse (List) (List) defun
        tha-list let
        tha-list len i let
        (
            i 0 > loop
                tha-list i 1 - index
                i 1 - i set
                i 0 >
            end
        )
    end

    concat (List List) (List) defun
        right let
        left let
        0 i let
        0 j let
        left len left-length let
        right len list-length let
        (
            i left-length < loop
                left i index
                i 1 + i set
                i left-length <
            end
            j list-length < loop
                right j index
                j 1 + j set
                j list-length <
            end
        )
    end

    first (List) (Any) defun
        tha-list let
        tha-list len 0 > if
            tha-list 0 index
        else
            null
        end
    end

    first head let

    last (List) (Any) defun
        tha-list let
        tha-list len list-length let
        list-length 0 > if
            tha-list list-length 1 - index
        else
            null
        end
    end

    tail (List) (List) defun
        tha-list let
        1 i let
        tha-list len list-length let
        (
            i list-length < loop
                tha-list i index
                i 1 + i set
                i list-length <
            end
        )
    end

    tail rest let

    count (List) (Int) defun
        len
    end

    isEmpty (List) (Bool) defun
        len 0 =
    end

    includes (List Any) (Bool) defun
        needle let
        tha-list let
        0 i let
        false found let
        tha-list len list-length let
        i list-length < found ! & loop
            tha-list i index needle = if
                true found set
            end
            i 1 + i set
            i list-length < found ! &
        end
        found
    end

    any (List Func) (Bool) defun
        callback let
        tha-list let
        0 i let
        false found let
        tha-list len list-length let
        i list-length < found ! & loop
            tha-list i index callback call if
                true found set
            end
            i 1 + i set
            i list-length < found ! &
        end
        found
    end

    all (List Func) (Bool) defun
        callback let
        tha-list let
        0 i let
        true ok let
        tha-list len list-length let
        i list-length < ok & loop
            tha-list i index callback call ! if
                false ok set
            end
            i 1 + i set
            i list-length < ok &
        end
        ok
    end

    shift (List) (Any) defun
        tha-list let
        tha-list len 0 > if 
            tha-list 0 index forRet let
            tha-list 0 remove
            forRet
        else
            null
        end
    end

    popLast (List) (Any) defun
        tha-list let
        tha-list len list-length let
        list-length 0 > if
            tha-list list-length 1 - index forRet let
            tha-list list-length 1 - remove
            forRet
        else
            null
        end
    end

    insert (List Int Any) (List) defun
        tha-val let
        tha-idx let
        tha-list let
        tha-idx tha-list len >= if
            tha-list tha-val append
            tha-list
        else
            0 tha-idx >= if 
                tha-list reverse call tha-val append reverse call
            else
                0 i let
                (
                    i tha-list len < loop
                        i tha-idx = if 
                            tha-val
                        end
                        tha-list i index
                        i 1 + i set
                        i tha-list len <
                    end
                )
            end
        end
    end

    @unpack apply
        tha-list let
        tha-list type "list" != if 
            null
        else
            0 i let
            tha-list len l let
            i l < loop
                tha-list i index
                i 1 + i set
                i l <
            end
        end
    end
    @each apply
        Lists::each call
    end
    @copy apply
        Lists::copy call
    end
    @collect apply
        Lists::collect call
    end
    @filter apply
        Lists::filter call
    end
    @reduce apply
        Lists::reduce call
    end
    @reverse apply
        Lists::reverse call
    end
    @concat apply
        Lists::concat call
    end
    @first apply
        Lists::first call
    end
    @last apply
        Lists::last call
    end
    @tail apply
        Lists::tail call
    end
    @count apply
        Lists::count call
    end
    @isEmpty apply
        Lists::isEmpty call
    end
    @includes apply
        Lists::includes call
    end
    @any apply
        Lists::any call
    end
    @all apply
        Lists::all call
    end
    @shift apply
        Lists::shift call
    end
    @popLast apply
        Lists::popLast call
    end
    @insert apply
        Lists::insert call
    end

end
