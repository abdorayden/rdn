"Typecheck" load
"Strings" load
"Lists" load
"Core" load [*for str*]
Core open

Regex module

    "[0-9]" DIGITS const

    match-str (Str Str) (Bool) defun
        match
    end

    [*local macro*]
    __spl demac
        " " Strings::@split
    end

    search (Str Str) (Any [*str but it can be null*]) defun
        [* str pattrn *]
        swap
        [* pattrn str *]
        Regex::__spl
        [* pattrn list *]
        splited let
        patt let
        splited len n let
        0 i let
        i n < loop
            splited i index Strings::@trim-space curr let
            patt curr Regex::match-str call if
                curr @str
                ret
            end

            i 1 + i set
            i n <
        end
        null
    end

    search-all (Str Str) (List) defun
        [* str pattrn *]
        swap
        [* pattrn str *]
        Regex::__spl
        [* pattrn list *]
        splited let
        patt let

        splited len n let
        0 i let

        (
           i n < loop
               splited i index Strings::@trim-space curr let
               patt curr Regex::match-str call if
                   curr @str
               end
        
               i 1 + i set
               i n <
           end
        )
    end

    @match-str apply
        Regex::match-str call
    end

    @search apply
        Regex::search call
    end

    @search-all apply
        Regex::search-all call
    end

end
