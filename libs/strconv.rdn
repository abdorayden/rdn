[* 
strconv.rdn
Copyright (c) 2023-2026 Ray Den
SPDX-License-Identifier: MIT

Purpose:
Conversion helpers inspired by Go's `strconv` package.

Loading behavior:
This module chooses the shared-library suffix from __sharedlib_ext and loads:
../nativelibs/strconv(.so|.dylib|.dll)

Exports:
- atoi       : text -> integer
- atof       : text -> double
- parseBool  : text -> boolean
- itoa       : integer -> string
- formatBool : boolean -> string

Examples:
"./libs/strconv.rdn" load
"42" atoi call print
"\n" print
true formatBool call print
*]

"Typecheck" load
"../nativelibs/strconv" __sharedlib_ext to_string swap pop append loadnative

Typecheck::OGTypes open

Strconv module

    Ascii module

        chr (Int) (Str) defun
            ascii_chr call
        end

        ord (Str) (Int) defun
            ascii_ord call
        end

    end

    atoi (Str) (Int) defun
        _atoi call
    end
    atof (Str) (Real) defun
        _atof call
    end
    parse-bool (Str) (Bool) defun
        parseBool call
    end
    itoa (Int) (Str) defun
        _itoa call
    end
    format-bool (Bool) (Str) defun
        formatBool call
    end

    @atoi apply
        Strconv::atoi call
    end
    @atof apply
        Strconv::atof call
    end
    @parse-bool apply
        Strconv::parse-bool call
    end
    @itoa apply
        Strconv::itoa call
    end
    @format-bool apply
        Strconv::format-bool call
    end

end
