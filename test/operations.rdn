[*
    this file is for testing
*]
1 1 2 2 + + + print "\n" print [* test sum *]
3 3 * print "\n" print [* test mul *]
3 3 / print "\n" print [* test div *]
4 1 - print "\n" print [* test minus *]
4 1 << print "\n" print [* test shl *]
4 1 >> print "\n" print [* test shr *]
4 1 | print "\n" print [* test or *]
4 1 & print "\n" print [* test and *]
4 1 ^ print "\n" print [* test xor *]
-4 1 + print "\n" print [* negative integer literal *]
4 -1 + print "\n" print [* negative rhs integer literal *]
4 -1 - print "\n" print [* subtract negative integer *]
0x10 2 + print "\n" print [* hex literal *]
0b1010 1 + print "\n" print [* binary literal *]
0o12 1 + print "\n" print [* octal literal *]
-0x10 1 + print "\n" print [* negative hex literal *]
-0b10 3 * print "\n" print [* negative binary literal *]
