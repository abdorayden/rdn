[* false condition skips body *]
false loop
    "wrong" print "\n" print
    false
end

[* counting down *]
3 i let
i 0 > loop
    i print "\n" print
    i 1 - i let
    i 0 >
end

[* loop-local scope *]
1 outer let
true loop
    9 outer let
    "inner outer = " print outer print "\n" print
    false
end
"outer after = " print outer print "\n" print

[* continue and break *]
4 n let
n 0 > loop
    n 1 - n let

    n 2 = if
        n 0 >
        continue
    end

    n 1 = if
        break
    end

    n print "\n" print
    n 0 >
end
