"../libs/typecheck.rdn" load

add_ints (Int Int) (Int) defun
    +
end

stringify (Int) (Str) defun
    to_string swap pop
end

identity_any (Any) (Any) defun
end

call_with_9 (Func) (Any) defun
    9 swap scall
end

bad_return () (Int) defun
    "bad"
end

2 3 add_ints check print "\n" print
pop
pop
2 3 add_ints scall print "\n" print
8 stringify scall print "\n" print
true identity_any scall print "\n" print
"ok" identity_any scall print "\n" print
identity_any call_with_9 scall print "\n" print

mismatch_args defun
    "x" 1 add_ints scall
end

"x" 1 add_ints check print "\n" print
pop
pop
