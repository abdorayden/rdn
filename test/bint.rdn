"../libs/bint.rdn" load

[* Basic arithmetic *]
"123" "456" Bint::@badd call print "\n" print
"100" "50" Bint::@bsub call print "\n" print
"12" "34" Bint::@bmul call print "\n" print
"100" "30" Bint::@bdiv call print "\n" print
"100" "30" Bint::@bmod call print "\n" print

[* Power *]
"2" 10 Bint::@bpow call print "\n" print
"7" 13 Bint::@bpow call print "\n" print

[* Negation and absolute value *]
"123" Bint::@bneg call print "\n" print
"-123" Bint::@babs call print "\n" print
"0" Bint::@bneg call print "\n" print

[* Comparison *]
"123" "456" Bint::@beq call print "\n" print
"123" "456" Bint::@blt call print "\n" print
"123" "456" Bint::@bgt call print "\n" print
"500" "200" Bint::@bgt call print "\n" print
"123" "123" Bint::@bcmp call print "\n" print
"100" "200" Bint::@bcmp call print "\n" print
"200" "100" Bint::@bcmp call print "\n" print

[* Negative arithmetic *]
"5" "-3" Bint::@badd call print "\n" print
"5" "-8" Bint::@badd call print "\n" print
"-5" "-3" Bint::@badd call print "\n" print
"5" "-3" Bint::@bsub call print "\n" print

[* Zero handling *]
"0" "5" Bint::@badd call print "\n" print

[* Auto-convert from Raden integers *]
123 456 Bint::@badd call print "\n" print

[* Large numbers *]
"12345678901234567890" "9876543210" Bint::@badd call print "\n" print
"999999999" "999999999" Bint::@bmul call print "\n" print

[* Bitwise (non-negative only) *]
"12" "10" Bint::@band call print "\n" print
"12" "10" Bint::@bor call print "\n" print
"12" "10" Bint::@bxor call print "\n" print

[* Shift *]
"5" 60 Bint::@bshl call print "\n" print
"5764607523034234880" 60 Bint::@bshr call print "\n" print
