"../libs/lists.rdn" load

doubler defun
    2 *
end

aboveTwo defun
    2 >
end

sum2 defun
    +
end

positive defun
    0 >
end

(1 2 3) copy call print "\n" print
(1 2 3) doubler collect call print "\n" print
(1 2 3 4) aboveTwo filter call print "\n" print
(1 2 3 4) 0 sum2 reduce call print "\n" print
(1 2 3) reverse call print "\n" print
(1 2) (3 4) concat call print "\n" print
(9 8 7) first call print "\n" print
(9 8 7) last call print "\n" print
(9 8 7) tail call print "\n" print
() isEmpty call print "\n" print
(1) isEmpty call print "\n" print
(1 2 3) 2 includes call print "\n" print
(1 2 3) 9 includes call print "\n" print
(1 2 3) positive any call print "\n" print
(1 2 3) positive all call print "\n" print

(10 20 30) numbers let
numbers shift call print "\n" print
numbers print "\n" print
numbers popLast call print "\n" print
numbers print
