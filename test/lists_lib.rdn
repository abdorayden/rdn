"../libs/lists.rdn" load

doubler defun
    2 *
end

aboveTwo defun
    2 >
end

sum2 defun
    +
end

positive defun
    0 >
end

(1 2 3) Lists::copy call print "\n" print
(1 2 3) doubler Lists::collect call print "\n" print
(1 2 3 4) aboveTwo Lists::filter call print "\n" print
(1 2 3 4) 0 sum2 Lists::reduce call print "\n" print
(1 2 3) Lists::reverse call print "\n" print
(1 2) (3 4) Lists::concat call print "\n" print
(9 8 7) Lists::first call print "\n" print
(9 8 7) Lists::last call print "\n" print
(9 8 7) Lists::tail call print "\n" print
() Lists::isEmpty call print "\n" print
(1) Lists::isEmpty call print "\n" print
(1 2 3) 2 Lists::includes call print "\n" print
(1 2 3) 9 Lists::includes call print "\n" print
(1 2 3) positive Lists::any call print "\n" print
(1 2 3) positive Lists::all call print "\n" print

(10 20 30) numbers let
numbers Lists::shift call print "\n" print
numbers print "\n" print
numbers Lists::popLast call print "\n" print
numbers print
