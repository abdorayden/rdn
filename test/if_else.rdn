[* true branch *]
true if
    "then branch" print
else
    "else branch" print
end

[* false branch *]
false if
    "wrong branch" print
else
    "right branch" print
end

[* nested if *]
true if
    false if
        "nested wrong" print
    else
        "nested else" print
    end
else
    "outer else" print
end
