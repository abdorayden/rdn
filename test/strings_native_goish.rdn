"../libs/strings.rdn" load

"hello world" "world" contains call print "\n" print
"prefix-value" "prefix-" hasPrefix call print "\n" print
"file.txt" ".txt" hasSuffix call print "\n" print
"  alpha beta  " trimSpace call print "\n" print
"a,b,c" "," split call print "\n" print
"go gopher go" "go" "rdn" replaceAll call print
