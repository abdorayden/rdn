[* 
todo_tui.rdn
Copyright (c) 2023-2026 Ray Den
SPDX-License-Identifier: MIT

Purpose:
Simple line-driven terminal todo application written in Raden.

Notes:
- This is a prompt-based TUI, not a full-screen curses interface.
- Tasks are managed in memory for the current session only.
- Commands operate by task title because the language does not yet expose a
  string-to-integer conversion helper for indexed input.

Run:
./main apps/todo.rdn
*]

"../libs/io.rdn" load
"../libs/lists.rdn" load

() __todo_pending let
() __todo_done let

stringValue defun
    to_string
    swap pop
end

printBanner defun
    "\nRaden Todo TUI" Io::@println
    "----------------" Io::@println
end

printHelp defun
    "commands:" Io::@println
    "  help   show this help" Io::@println
    "  list   show pending and done tasks" Io::@println
    "  add    add a new pending task" Io::@println
    "  done   move a pending task to done by exact title" Io::@println
    "  undo   move a done task back to pending by exact title" Io::@println
    "  clear  remove all done tasks" Io::@println
    "  quit   exit the app" Io::@println
end

printTaskGroup defun
    items let
    title let
    title Io::@println
    items Lists::isEmpty call if
        "  (empty)" Io::@println
    else
        0 i let
        items len list-length let
        i list-length < loop
            "  " print
            i 1 + print
            ". " print
            items i index Io::@println
            i 1 + i set
            i list-length <
        end
    end
end

renderState defun
    "\n" print
    "pending tasks" __todo_pending printTaskGroup call
    "\n" print
    "done tasks" __todo_done printTaskGroup call
end

findTaskIndex defun
    target let
    items let
    0 i let
    null found let
    items len list-length let
    i list-length < found null = & loop
        items i index target = if
            i found set
        end
        i 1 + i set
        i list-length < found null = &
    end
    found
end

moveTaskByTitle defun
    to-list let
    from-list let
    title let

    from-list title findTaskIndex call found-index let
    found-index null = if
        false
    else
        from-list found-index index stringValue call moved-task let
        to-list moved-task stringValue call append
        from-list found-index remove
        true
    end
end

addTask defun
    "new task> " Io::prompt call title let
    title null = if
        false
    else
        title len 0 > if
            __todo_pending title stringValue call append
            "added task." Io::@println
            true
        else
            "empty task ignored." Io::@println
            false
        end
    end
end

markDone defun
    "done task title> " Io::prompt call title let
    title null = if
        false
        ret
    end
    title stringValue call __todo_pending __todo_done moveTaskByTitle call if
        "marked done." Io::@println
        true
        ret
    end
    "pending task not found." Io::@println
    false
end

undoDone defun
    "undo task title> " Io::prompt call title let
    title null = if
        false
    else
        title stringValue call __todo_done __todo_pending moveTaskByTitle call if
            "moved back to pending." Io::@println
            true
        else
            "done task not found." Io::@println
            false
        end
    end
end

clearDone defun
    () __todo_done set
    "cleared done tasks." Io::@println
end

runTodoTui defun
    () __todo_pending set
    () __todo_done set

    printBanner call
    printHelp call

    true running let
    running loop
        "\ncmd> " Io::prompt call command let
        command null = if
            false running set
        else
            command "help" = command "h" = | if
                printHelp call
            else
                command "list" = command "ls" = | if
                    renderState call
                else
                    command "add" = if
                        addTask call pop
                    else
                        command "done" = if
                            markDone call pop
                        else
                            command "undo" = if
                                undoDone call pop
                            else
                                command "clear" = if
                                    clearDone call
                                else
                                    command "quit" = command "q" = | if
                                        false running set
                                    else
                                        "unknown command. type 'help'." Io::@println
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        running
    end

    "\nbye." Io::@println
end
