800
600
"rdn test"
init-window call

window-should-close call ! loop
    get-screen-width call width let
    get-screen-height call height let
    begin-drawing call
    0xFFFFFFFF clear-background call

    100 100 50 50 0xFF0000FF draw-rect call
    width 150 - 
    100 50 50 0xFF0000FF draw-rect call
    End-drawing call

    window-should-close call !
end

close-window call
